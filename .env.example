# Copy to .env and fill in before running `docker compose up`.

# --- Anthropic (chatbot-service) -------------------------------------------------------------
# Required. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=2048

# --- Shared JWT secret (plm-api + chatbot-service must use the same one) ---------------------
# Must be at least 32 characters. Generate one with: openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me-please-32chars
JWT_TTL_MINUTES=120

# --- DynamoDB (defaults target DynamoDB Local in docker-compose; point at real AWS creds/region
#     to run plm-api / chatbot-service against production DynamoDB instead) ------------------
DYNAMO_REGION=us-east-1
DYNAMO_ACCESS_KEY=local
DYNAMO_SECRET_KEY=local

# --- Seed data ---------------------------------------------------------------------------------
# Set to false to skip loading the sample rack/server/PSU/supplier/ECO dataset on plm-api startup.
SEED_ENABLED=true
